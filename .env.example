# Set these in Vercel Project Settings > Environment Variables. Never commit values.
GROQ_API_KEY=
DESKTER_ADMIN_KEY=
# Bootstrap device key (>=32 characters). Use a different key from the admin key.
DESKTER_DEVICE_KEY=
# Durable settings, device keys, throttling and WebSocket history. REST Redis API.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VERCEL_SUPPORT_LARGE_FUNCTIONS=1
MITHI_THREADS=1
MITHI_CACHE_MB=4
# Optional: deploy as lean text/ASR API without Mithi dependencies/build assets.
# Default enables direct Mithi inference.
MITHI_ENABLED=1
